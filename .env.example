# SEC requires a descriptive User-Agent for automated access.
SEC_USER_AGENT="YourName your-email@example.com"
SEC_TIMEOUT_SECONDS=30
SEC_MAX_RETRIES=4
# Keep <= 10 to comply with SEC fair-access guidance.
SEC_REQUESTS_PER_SECOND=8
SEC_CACHE_TTL_SECONDS=3600

DEMO_MODE=true
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6
RERANKER_ENABLED=true

CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=120

API_BASE_URL=http://127.0.0.1:8000
MAX_QUERY_CHARS=5000
MAX_TOOL_CALLS=5
REQUEST_SIZE_LIMIT_BYTES=1000000
SQLITE_PATH=data/metadata/app.db

# Optional cost estimates. Enter your provider's current prices in USD per 1M tokens.
# PRICING_INPUT_PER_1M=
# PRICING_OUTPUT_PER_1M=
